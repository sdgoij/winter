# Editors, match the repository: `.gitattributes` stores and checks out LF.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{toml,yml,yaml,json}]
indent_size = 2

[*.md]
# Markdown uses two trailing spaces for a hard break.
trim_trailing_whitespace = false
