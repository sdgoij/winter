# Build artefacts. `**/target` covers the fuzz workspace too.
**/target

# Reference material, not part of the port.
/.design/refs

# Editor and compiler scratch files.
**/*.rs.bk

# The file `git commit -F` reads a message from.
/.commit-msg-tmp

# Local state a run may create; never commit it.
*.db
*.db-wal
*.db-shm

# OS noise.
.DS_Store
Thumbs.db

# Release packaging, generated per tag.
/dist

# The GitHub Pages staging directory `registry-publish` writes.
/_site

# The VS Code demo's installed packages and compiled JavaScript, and the addon
# `npm run build:addon` copies in for it to load.
/editors/vscode/node_modules
/editors/vscode/out
/editors/vscode/winter.node
