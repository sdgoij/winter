{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "winter: build server",
      "type": "shell",
      "command": "cargo build -p winter-demo",
      "options": { "cwd": "${workspaceFolder}/../.." },
      "problemMatcher": []
    },
    {
      "label": "winter: compile extension",
      "type": "shell",
      "command": "npm run compile",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "winter: prepare",
      "dependsOn": ["winter: compile extension", "winter: build server"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
