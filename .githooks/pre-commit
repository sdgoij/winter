#!/bin/sh
# Pre-commit floor: formatting, lints, and the dependency policy.
#
# Install once per clone with `just hooks`. This is not the gate; run
# `just gate` before claiming anything is green. Set WINTERM_PRECOMMIT_TESTS=1
# to add the workspace suite.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo is not on PATH; skipping the gate" >&2
    exit 0
fi

echo "pre-commit: cargo fmt --all --check"
cargo fmt --all --check

echo "pre-commit: clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

# The licence and advisory gate needs a tool Cargo does not ship. Skipping it
# with a warning keeps a fresh clone committable; CI still runs it either way.
if command -v cargo-deny >/dev/null 2>&1; then
    echo "pre-commit: deny check"
    cargo deny check
else
    echo "pre-commit: cargo-deny is not installed; skipping the licence and advisory check" >&2
    echo "pre-commit: install it with 'cargo install cargo-deny --locked'" >&2
fi

if [ "${WINTERM_PRECOMMIT_TESTS:-0}" = "1" ]; then
    echo "pre-commit: test --workspace"
    cargo test --workspace
fi

echo "pre-commit: ok"
